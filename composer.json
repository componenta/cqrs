{
    "name": "componenta/cqrs",
    "description": "CQRS (Command Query Responsibility Segregation) library for PHP 8.5.13+",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "cqrs",
        "command",
        "query",
        "bus",
        "ddd"
    ],
    "require": {
        "php": "^8.5.13",
        "php-64bit": "*",
        "componenta/config": "^3.0.0",
        "componenta/di": "^6.0",
        "componenta/identity": "^1.1.0",
        "componenta/reflection": "^2.0.1",
        "psr/clock": "^1.0",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "phpbench/phpbench": "^1.7",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\CQRS\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\CQRS\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "extra": {
        "branch-alias": {
            "dev-main": "5.0.x-dev"
        },
        "componenta": {
            "config-providers": [
                "Componenta\\CQRS\\ConfigProvider"
            ]
        }
    },
    "scripts": {
        "test": "@php vendor/bin/pest",
        "analyse": "@php vendor/bin/phpstan analyse src --level=max",
        "bench": "@php vendor/bin/phpbench run --config=phpbench.json.dist --report=aggregate"
    }
}
